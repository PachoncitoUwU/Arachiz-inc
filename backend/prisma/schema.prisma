generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String               @id @default(cuid())
  userType             String
  fullName             String
  document             String               @unique
  email                String               @unique
  password             String
  avatarUrl            String?
  nfcUid               String?              @unique
  huellas              Int[]                @default([])
  createdAt            DateTime             @default(now())
  faceDescriptor       Float[]              @default([])
  asistencias          Asistencia[]         @relation("InstructorAsistencia")
  breakoutScore        BreakoutScore?
  excusas              Excusa[]
  fichasAdmin          Ficha[]              @relation("InstructorAdmin")
  fichasAdministradas  Ficha[]              @relation("Administrador")
  fichasInst           FichaInstructor[]
  flappyScore          FlappyScore?
  materias             Materia[]            @relation("InstructorMaterias")
  memoryScore          MemoryScore?
  reactionScore        ReactionScore?
  registros            RegistroAsistencia[]
  snakeScore           SnakeScore?
  towerScore           TowerScore?
  userSkins            UserSkin[]
  wordleScore          WordleScore?
  fichasApr            Ficha[]              @relation("Aprendices")
  materiasEvitadas     MateriaEvitada[]
  respuestasRapidas    RespuestaRapida[]    @relation("RespuestasRapidas")
  papeleraEliminados   Papelera[]           @relation("EliminadoPor")
  historialCambios     HistorialCambios[]   @relation("UsuarioCambios")
  conflictosInstructor ConflictoHorario[]   @relation("ConflictosInstructor")
  conflictosCreados    ConflictoHorario[]   @relation("ConflictosCreados")
  rachaAsistencia      Int                  @default(0)
  pushSubscriptions    PushSubscription[]
  mensajesEnviados     MensajeChat[]
  superUserLogs        SuperUserAuditLog[]  @relation("SuperUserLogs")
}

model Ficha {
  id                String              @id @default(cuid())
  numero            String              @unique
  nivel             String
  centro            String
  jornada           String
  region            String              @default("")
  duracion          Int                 @default(0)
  code              String              @unique
  createdAt         DateTime            @default(now())
  instructorAdminId String?
  administradorId   String?
  nombre            String              @default("Programa sin nombre")
  instructorAdmin   User?               @relation("InstructorAdmin", fields: [instructorAdminId], references: [id])
  administrador     User?               @relation("Administrador", fields: [administradorId], references: [id])
  instructores      FichaInstructor[]
  horarios          Horario[]
  materias          Materia[]
  aprendices        User[]              @relation("Aprendices")
  papelera          Papelera[]          @relation("FichaPapelera")
  historialCambios  HistorialCambios[]  @relation("FichaHistorial")
  mensajesChat      MensajeChat[]

  @@index([administradorId])
}

model FichaInstructor {
  id           String @id @default(cuid())
  role         String @default("invitado")
  fichaId      String
  instructorId String
  ficha        Ficha  @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  instructor   User   @relation(fields: [instructorId], references: [id], onDelete: Cascade)

  @@unique([fichaId, instructorId])
}

model Materia {
  id               String             @id @default(cuid())
  nombre           String
  tipo             String
  fichaId          String
  instructorId     String?
  asistencias      Asistencia[]
  horarios         Horario[]
  excusas          Excusa[]
  ficha            Ficha              @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  instructor       User?              @relation("InstructorMaterias", fields: [instructorId], references: [id])
  materiasEvitadas MateriaEvitada[]
}

model Horario {
  id         String  @id @default(cuid())
  dia        String
  horaInicio String
  horaFin    String
  fichaId    String
  materiaId  String
  ficha      Ficha   @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  materia    Materia @relation(fields: [materiaId], references: [id], onDelete: Cascade)
}

model Asistencia {
  id           String               @id @default(cuid())
  fecha        String
  activa       Boolean              @default(true)
  timestamp    DateTime             @default(now())
  materiaId    String
  instructorId String
  instructor   User                 @relation("InstructorAsistencia", fields: [instructorId], references: [id])
  materia      Materia              @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  registros    RegistroAsistencia[]
  llegadaTarde Int                  @default(15)
  duracion     Int                  @default(120)
  aula         String?
  descripcion  String?
}

model RegistroAsistencia {
  id           String     @id @default(cuid())
  presente     Boolean    @default(true)
  metodo       String     @default("manual")
  timestamp    DateTime   @default(now())
  justificado  Boolean    @default(false)
  tarde        Boolean    @default(false)
  asistenciaId String
  aprendizId   String
  aprendiz     User       @relation(fields: [aprendizId], references: [id], onDelete: Cascade)
  asistencia   Asistencia @relation(fields: [asistenciaId], references: [id], onDelete: Cascade)
  excusas      Excusa[]

  @@unique([asistenciaId, aprendizId])
}

model Excusa {
  id                   String              @id @default(cuid())
  fechas               String
  motivo               String
  archivosUrls         String?
  estado               String              @default("Pendiente")
  respuesta            String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @default(now()) @updatedAt
  respondedAt          DateTime?
  aprendizId           String
  materiaId            String
  registroAsistenciaId String?
  aprendiz             User                @relation(fields: [aprendizId], references: [id], onDelete: Cascade)
  materia              Materia             @relation(fields: [materiaId], references: [id], onDelete: Cascade)
  registroAsistencia   RegistroAsistencia? @relation(fields: [registroAsistenciaId], references: [id], onDelete: SetNull)

  @@index([aprendizId])
  @@index([materiaId])
  @@index([estado])
}

model MateriaEvitada {
  id         String   @id @default(cuid())
  aprendizId String
  materiaId  String
  createdAt  DateTime @default(now())
  aprendiz   User     @relation(fields: [aprendizId], references: [id], onDelete: Cascade)
  materia    Materia  @relation(fields: [materiaId], references: [id], onDelete: Cascade)

  @@unique([aprendizId, materiaId])
}

model SnakeScore {
  id        String   @id @default(cuid())
  score     Int
  updatedAt DateTime @default(now()) @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model BreakoutScore {
  id        String   @id @default(cuid())
  score     Int
  updatedAt DateTime @default(now()) @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model FlappyScore {
  id        String   @id @default(cuid())
  score     Int
  updatedAt DateTime @default(now()) @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TowerScore {
  id        String   @id @default(cuid())
  score     Int
  updatedAt DateTime @default(now()) @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ReactionScore {
  id        String   @id @default(cuid())
  score     Int
  updatedAt DateTime @default(now()) @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MemoryScore {
  id        String   @id @default(cuid())
  score     Int
  updatedAt DateTime @default(now()) @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WordleScore {
  id        String   @id @default(cuid())
  score     Int
  updatedAt DateTime @default(now()) @updatedAt
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SnakeSkin {
  id          String      @id @default(cuid())
  name        String      @unique
  description String
  price       Float
  rarity      String
  headColor   String
  bodyColor   String
  pattern     String
  trailEffect String?
  eyeStyle    String      @default("normal")
  isDefault   Boolean     @default(false)
  createdAt   DateTime    @default(now())
  orders      SkinOrder[]
  userSkins   UserSkin[]
}

model UserSkin {
  id         String    @id @default(cuid())
  userId     String
  skinId     String
  equipped   Boolean   @default(false)
  unlockedAt DateTime  @default(now())
  skin       SnakeSkin @relation(fields: [skinId], references: [id], onDelete: Cascade)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skinId])
}

model SkinOrder {
  id            String     @id @default(cuid())
  userId        String?
  skinId        String?
  amount        Float
  currency      String    @default("COP")
  status        String
  paymentMethod String?
  externalId    String?
  preferenceId  String?
  createdAt     DateTime  @default(now())
  approvedAt    DateTime?
  skin          SnakeSkin? @relation(fields: [skinId], references: [id])

  @@index([userId])
  @@index([externalId])
  @@index([preferenceId])
}

model RespuestaRapida {
  id           String   @id @default(cuid())
  instructorId String
  texto        String
  orden        Int
  createdAt    DateTime @default(now())
  instructor   User     @relation("RespuestasRapidas", fields: [instructorId], references: [id], onDelete: Cascade)

  @@index([instructorId])
}

model Papelera {
  id                String   @id @default(cuid())
  tipoElemento      String
  elementoId        String
  fichaId           String
  eliminadoPor      String
  rolEliminador     String
  fechaEliminacion  DateTime @default(now())
  datosOriginales   Json
  razonEliminacion  String?
  ficha             Ficha    @relation("FichaPapelera", fields: [fichaId], references: [id], onDelete: Cascade)
  usuario           User     @relation("EliminadoPor", fields: [eliminadoPor], references: [id], onDelete: Cascade)

  @@index([fichaId])
  @@index([eliminadoPor])
  @@index([tipoElemento])
  @@index([fechaEliminacion])
}

model HistorialCambios {
  id              String   @id @default(cuid())
  fichaId         String
  usuarioId       String
  tipoEvento      String
  entidad         String
  entidadId       String
  descripcion     String
  datosAnteriores Json?
  datosNuevos     Json?
  fechaHora       DateTime @default(now())
  ipAddress       String?
  ficha           Ficha    @relation("FichaHistorial", fields: [fichaId], references: [id], onDelete: Cascade)
  usuario         User     @relation("UsuarioCambios", fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([fichaId])
  @@index([usuarioId])
  @@index([tipoEvento])
  @@index([entidad])
  @@index([fechaHora])
}

model ConflictoHorario {
  id           String    @id @default(cuid())
  instructorId String
  dia          String
  descripcion  String
  horarioIds   Json      // Array de IDs de horarios en conflicto
  resuelto     Boolean   @default(false)
  creadoPor    String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  instructor   User      @relation("ConflictosInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  admin        User?     @relation("ConflictosCreados", fields: [creadoPor], references: [id], onDelete: SetNull)

  @@index([instructorId])
  @@index([resuelto])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model MensajeChat {
  id        String   @id @default(cuid())
  texto     String
  fichaId   String
  senderId  String
  createdAt DateTime @default(now())
  ficha     Ficha    @relation(fields: [fichaId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([fichaId])
  @@index([senderId])
}

model SuperUserAuditLog {
  id                String   @id @default(cuid())
  superUserId       String
  accion            String
  entidad           String
  entidadId         String?
  descripcion       String
  datosAnteriores   Json?
  datosNuevos       Json?
  ipAddress         String?
  fechaHora         DateTime @default(now())
  navegador         String?

  superUser         User     @relation("SuperUserLogs", fields: [superUserId], references: [id], onDelete: Cascade)

  @@index([superUserId])
  @@index([fechaHora])
  @@index([entidad])
}
